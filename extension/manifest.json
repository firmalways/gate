{
  "manifest_version": 3,
  "name": "FirmAlways Gate",
  "version": "0.1.0",
  "description": "Masks Thai personal data before you paste it into ChatGPT, Claude or Gemini, using your own FirmAlways Gate.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "src/background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": ["src/lib.js", "src/content.js"],
      "run_at": "document_start"
    }
  ],
  "options_ui": { "page": "src/options.html", "open_in_tab": true }
}
